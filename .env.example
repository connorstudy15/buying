# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# Dual-Tower D0-role（仅实验脚本使用；不影响正式 embedding 客户端）
# 未配置 endpoint 时，会从 EMBEDDING_BASE_URL / LLM_BASE_URL 的工作空间域名推导。
# DUAL_TOWER_NATIVE_ENDPOINT=https://<workspace>.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# DUAL_TOWER_API_KEY=
DUAL_TOWER_MODEL=qwen3.7-text-embedding-flash
DUAL_TOWER_DIMENSION=1024
DUAL_TOWER_MAX_BATCH=20

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# RERANKER_BASE_URL=https://your-reranker-host
# RERANKER_API_KEY=sk-xxx
# RERANKER_MODEL=qwen3-reranker-8b

# Hybrid 代码已可用；冻结评测未证明在线收益，默认保留当前主链。
HYBRID_RECALL_ENABLED=0

# ===== 知识检索 Query Rewrite / Decomposition V1 =====
# 默认关闭以保留 legacy 基线；启用后 QueryProcessor 默认复用上面的 LLM 网关、Key 和模型。
KNOWLEDGE_QUERY_TRANSFORM_ENABLED=0
# QUERY_PROCESSOR_BASE_URL=
# QUERY_PROCESSOR_API_KEY=
# QUERY_PROCESSOR_MODEL=
QUERY_PROCESSOR_MAX_SUBQUERIES=3
# 阿里云混合推理模型建议开启；仅影响 QueryProcessor，不影响主 Agent。
QUERY_PROCESSOR_DISABLE_THINKING=0
KNOWLEDGE_RRF_K=60

# ===== 知识库隔离：应用只读 production，离线评测只读 eval =====
KNOWLEDGE_COLLECTION_PRODUCTION=globex_category_kb
KNOWLEDGE_COLLECTION_EVAL=globex_category_kb_eval

# ===== 上下文预算（token 单位） =====
CONTEXT_SIZE=128000
TOOL_RESULT_LIMIT=20000
# 完整摘要计量的上下文专项通过；回滚改回 legacy 并重启 API/worker。
CONTEXT_STRATEGY=layered
# 开发集选定 pressure：成功读取后且出现压力时裁剪，保护完整近期轮次。
CONTEXT_PRUNING_TIMING=pressure
CONTEXT_PRODUCT_TOKENS=6000
CONTEXT_TARGET_TOKENS=48000
TOKEN_BUDGET_TOTAL=0
# 非零启用调用前保守预留、实际usage结算；不足时规则回复不再调模型。

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic%20<base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5
# OTEL_SERVICE_NAME=globex-agent
# 默认 off：只导出输入输出字符数。仅本地开发排障可改为 development；
# development 只展示三个白名单只读工具的脱敏、截断后输入输出，模型正文仍不导出。
TRACE_CONTENT_MODE=off
# 无显式 OTLP 端点时，以下三项自动启用 Langfuse Basic Auth 与 v4 摄取。
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-你的项目公钥
# LANGFUSE_SECRET_KEY=sk-lf-你的项目私钥
# Langfuse 配置与脱敏边界见 docs/Langfuse与端到端Trace.md；真实密钥仅注入本地环境。
# 默认演示身份是客户端声明，不是登录；持久 session owner 绑定默认开启。
IDENTITY_MODE=demo
SESSION_OWNER_BINDING=1
# 仅隔离成对评测固定已导入版本；常规运行留空，按发布记录和买家分组。
PROMPT_PIN_VERSION=
# 全进程运维指标只给明确的签名主体；空值关闭，启用还须 IDENTITY_MODE=hmac。
METRICS_READER_BUYERS=
# 严格模式设 IDENTITY_MODE=hmac；密钥至少 32 字节，只保存在服务端环境。
# IDENTITY_HMAC_SECRET=

# 长期记忆默认使用 LLM 提炼 + 当前 EMBEDDING_* 建立持久向量；保存失败不回退原文。
# 权威库为 DATA_DIR/buyer_memory.db，每位买家最多 200 条。
# 正向语义召回数量；dislike 硬约束全量保留。
PREFERENCE_TOP_K=5
# 旧 PREFERENCE_RELEVANCE_ENABLED 仅影响旧 PreferenceSelector，新记忆默认语义召回。

# ===== Icecat 评测数据（仅本地评测使用） =====
# 注册 Free Open Icecat 后，在 My Icecat -> Access Tokens 创建动态 token。
# 真实用户名/token 只写入本地 .env，禁止提交到 Git 或评测产物。
# ICECAT_USERNAME=your-icecat-username
# ICECAT_API_TOKEN=your-api-token
# 图片等媒体资源暂不参与首轮检索评测，可先留空。
# ICECAT_CONTENT_TOKEN=
# 官方文档示例商品；若当前免费账户无权访问，可替换为 Open Icecat 商品 ID。
ICECAT_TEST_PRODUCT_ID=1399
